generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  admin
  grower
  processor
  buyer
}

enum OrganizationType {
  platform
  grower
  processor
  buyer
}

enum UserStatus {
  active
  disabled
}

enum HerbCategory {
  root
  wholeHerb
  fruitSeed
  flowerLeaf
  bark
  mineral
  other
}

enum BatchStage {
  planting
  harvested
  processing
  warehousing
  shipped
  sold
}

enum AuditStatus {
  pending
  approved
  rejected
}

enum AuditDecision {
  approved
  rejected
}

enum AuditSource {
  manual
  aiAssisted
}

enum RiskLevel {
  normal
  low
  medium
  high
}

enum BatchEventType {
  create
  audit
  stageChange
  qcReport
  storage
  transport
  transaction
  note
}

enum NotificationType {
  batchSubmitted
  auditResult
  stageChanged
  qcReportUploaded
  system
}

model Organization {
  id        String           @id @default(cuid())
  code      String           @unique
  name      String
  type      OrganizationType
  province  String?
  city      String?
  address   String?
  enabled   Boolean          @default(true)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  users            User[]
  grownBatches     HerbBatch[] @relation("BatchGrowerOrganization")
  processedBatches HerbBatch[] @relation("BatchProcessorOrganization")

  @@index([type, enabled])
}

model User {
  id             String        @id @default(cuid())
  username       String        @unique
  email          String        @unique
  passwordHash   String
  displayName    String
  role           UserRole
  status         UserStatus    @default(active)
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  createdBatches      HerbBatch[]    @relation("BatchCreator")
  events              BatchEvent[]   @relation("EventOperator")
  audits              BatchAudit[]   @relation("AuditReviewer")
  uploadedAttachments Attachment[]   @relation("AttachmentUploader")
  notifications       Notification[]
  assistantConversation AssistantConversation?

  @@index([role, status])
  @@index([organizationId])
}

model HerbBatch {
  id                      String        @id @default(cuid())
  batchNo                 String        @unique
  traceCode               String        @unique
  herbName                String
  category                HerbCategory
  plantingStartDate       DateTime      @db.Date
  origin                  Json
  environment             String?
  coverImageUrl           String?
  description             String?
  requiresProcessing      Boolean       @default(true)
  stage                   BatchStage    @default(planting)
  auditStatus             AuditStatus   @default(pending)
  riskLevel               RiskLevel     @default(normal)
  growerOrganizationId    String
  growerOrganization      Organization  @relation("BatchGrowerOrganization", fields: [growerOrganizationId], references: [id], onDelete: Restrict)
  processorOrganizationId String?
  processorOrganization   Organization? @relation("BatchProcessorOrganization", fields: [processorOrganizationId], references: [id], onDelete: SetNull)
  createdById             String
  createdBy               User          @relation("BatchCreator", fields: [createdById], references: [id], onDelete: Restrict)
  version                 Int           @default(1)
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  events        BatchEvent[]
  audits        BatchAudit[]
  attachments   Attachment[]
  notifications Notification[]
  assistantTurns AssistantTurn[]

  @@index([stage])
  @@index([auditStatus, riskLevel])
  @@index([growerOrganizationId, auditStatus])
  @@index([processorOrganizationId, stage])
  @@index([createdById])
}

model BatchEvent {
  id           String         @id @default(cuid())
  batchId      String
  batch        HerbBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  type         BatchEventType
  title        String
  description  String?
  payload      Json?
  occurredAt   DateTime
  operatorId   String?
  operator     User?          @relation("EventOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  operatorName String?
  operatorRole UserRole?
  visibleRoles UserRole[]     @default([])
  fromStage    BatchStage?
  toStage      BatchStage?
  createdAt    DateTime       @default(now())

  attachments Attachment[]

  @@index([batchId, occurredAt])
  @@index([type])
  @@index([operatorId])
}

model BatchAudit {
  id           String        @id @default(cuid())
  batchId      String
  batch        HerbBatch     @relation(fields: [batchId], references: [id], onDelete: Cascade)
  reviewerId   String
  reviewer     User          @relation("AuditReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)
  reviewerName String
  decision     AuditDecision
  source       AuditSource   @default(manual)
  riskLevel    RiskLevel
  reason       String?
  evidence     Json?
  modelName    String?
  createdAt    DateTime      @default(now())

  @@index([batchId, createdAt])
  @@index([reviewerId])
  @@index([decision])
}

model Attachment {
  id           String      @id @default(cuid())
  batchId      String
  batch        HerbBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  eventId      String?
  event        BatchEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)
  uploadedById String?
  uploadedBy   User?       @relation("AttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  originalName String
  storageKey   String      @unique
  publicUrl    String?
  mimeType     String
  sizeBytes    Int
  checksum     String?
  createdAt    DateTime    @default(now())

  @@index([batchId])
  @@index([eventId])
  @@index([uploadedById])
}

model Notification {
  id          String           @id @default(cuid())
  type        NotificationType
  recipientId String
  recipient   User             @relation(fields: [recipientId], references: [id], onDelete: Cascade)
  batchId     String?
  batch       HerbBatch?       @relation(fields: [batchId], references: [id], onDelete: SetNull)
  title       String
  content     String
  metadata    Json?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  @@index([recipientId, readAt])
  @@index([batchId])
  @@index([createdAt])
}

enum AssistantTurnStatus {
  pending
  done
  error
  stopped
}

// MVP 每账号一套会话；version 与短租约防止跨标签/进程并发覆盖。
model AssistantConversation {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  version          Int      @default(0)
  runningRequestId String?
  runningUntil     DateTime?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  turns            AssistantTurn[]
}

model AssistantTurn {
  id                  String                @id @default(cuid())
  conversationId      String
  conversation        AssistantConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  requestId           String
  sequence            Int
  question            String
  requestedIdentifier String?
  actorRole           UserRole
  actorOrganizationId String?
  batchId             String?
  batch               HerbBatch?            @relation(fields: [batchId], references: [id], onDelete: SetNull)
  batchVersion        Int?
  batchLabel          Json?
  status              AssistantTurnStatus   @default(pending)
  reply               Json?
  errorCode           String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt

  @@unique([conversationId, requestId])
  @@unique([conversationId, sequence])
  @@index([batchId])
}
