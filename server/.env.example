PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# 默认不信任代理头；上线核对拓扑后填写代理 IP/CIDR，或同机代理专用 loopback。
TRUST_PROXY=off
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/liangmu_medicine?schema=public
DEEPSEEK_API_KEY=
# 模型名称可单独配置；默认使用当前 DeepSeek 文档中的 Flash 模型。
DEEPSEEK_MODEL=deepseek-flash
NODE_ENV=development
# 开发时留空会生成进程级随机密钥，重启后需重新登录；生产必须填写至少 32 字符的随机密钥。
JWT_SECRET=
# 生产必须 NODE_ENV=production、显式 HTTPS CLIENT_ORIGIN 和随机 JWT_SECRET。
# DATABASE_URL / DEEPSEEK_API_KEY 只配置在后端；TLS 参数以数据库提供商要求为准。
